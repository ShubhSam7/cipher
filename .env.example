# Copy to .env. Prisma CLI and Next.js both load this file.
# Local PostgreSQL example; use your own credentials and database name.
DATABASE_URL="postgresql://cipher:cipher@localhost:5432/cipher?schema=public"
# Use the unpooled connection URL for migrations; same as above for local Postgres.
DIRECT_URL="postgresql://cipher:cipher@localhost:5432/cipher?schema=public"

# Generate a unique secret, for example: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-secret"

# Gmail account used to send signup OTPs.
EMAIL_USER="your-account@gmail.com"
# Use a Gmail app password with 2-Step Verification enabled.
EMAIL_PASS="replace-with-gmail-app-password"

# Comma-separated admin accounts; rights are checked on the server.
ADMIN_EMAILS="bt23csa041@iiitn.ac.in"
